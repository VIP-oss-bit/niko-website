---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph / social */}
    <meta property="og:title" content="Alterations by Nicole · Bristol Tailoring Studio" />
    <meta property="og:description" content="A Bristol tailoring and alterations studio. Honest, careful work — by appointment." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    {/* Fonts — loaded without blocking the first paint */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #1A2238;
    --ink-soft: #3A4358;
    --ink-mute: #6B7280;
    --paper: #FAFAF7;
    --paper-warm: #F2EFE7;
    --rule: #D9D5C9;
    --rule-soft: #E8E4D6;
    --accent: #9A4A1F;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: var(--paper);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 6%;
  }

  /* Top nav */
  nav.top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 250, 247, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
    padding: 0.85rem 6%;
  }
  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand em {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.92rem;
  }
  .nav-links a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--accent);
  }

  /* Hero */
  .hero {
    padding: 5rem 0 6rem;
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-warm) 100%);
    border-bottom: 1px solid var(--rule);
  }
  .hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    font-weight: 500;
  }
  .hero h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
    color: var(--ink);
    max-width: 700px;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .hero-sub {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 600px;
    margin-bottom: 2.5rem;
  }
  .ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--ink);
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
  }
  .btn-ghost:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* Sections */
  section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  section:nth-of-type(even) {
    background: var(--paper-warm);
  }
  .sec-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    max-width: 700px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  p {
    color: var(--ink-soft);
    max-width: 680px;
    margin-bottom: 1rem;
  }
  p.lede {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink);
    max-width: 700px;
    margin-bottom: 1.5rem;
  }
  a {
    color: var(--accent);
  }

  /* Service grid */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    margin-top: 2rem;
  }
  .svc {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--rule-soft);
    border-right: 1px solid var(--rule-soft);
  }
  .svc:nth-child(2n) {
    border-right: none;
  }
  .svc h3 {
    margin-top: 0;
  }
  .svc ul {
    list-style: none;
    margin-top: 0.5rem;
    padding: 0;
  }
  .svc li {
    font-size: 0.92rem;
    color: var(--ink-soft);
    padding: 0.2rem 0;
    padding-left: 1rem;
    position: relative;
  }
  .svc li::before {
    content: '·';
    color: var(--accent);
    position: absolute;
    left: 0;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.2rem;
    line-height: 1;
    top: 0.4rem;
  }

  /* Info grid */
  .info-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0.75rem 2rem;
    margin: 2rem 0;
    max-width: 700px;
  }
  .info-grid dt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 0.25rem;
  }
  .info-grid dd {
    color: var(--ink);
  }
  .info-grid dd a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .info-grid dd a:hover {
    border-bottom-color: var(--accent);
  }

  /* Callout */
  .callout {
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    background: rgba(154, 74, 31, 0.04);
    margin: 2rem 0;
    max-width: 700px;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
  }

  /* Footer */
  footer {
    background: var(--ink);
    color: var(--paper);
    padding: 3rem 6% 2rem;
  }
  footer .foot-wrap {
    max-width: 960px;
    margin: 0 auto;
  }
  footer .foot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }
  footer h4 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--paper);
    margin-bottom: 0.5rem;
  }
  footer p,
  footer a {
    color: rgba(250, 250, 247, 0.7);
    font-size: 0.9rem;
    text-decoration: none;
  }
  footer a:hover {
    color: var(--paper);
  }
  footer .foot-meta {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(250, 250, 247, 0.15);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.5);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 720px) {
    .nav-links {
      gap: 1rem;
      font-size: 0.85rem;
    }
    .nav-links a:nth-child(3) {
      display: none;
    }
    .hero {
      padding: 3rem 0 4rem;
    }
    section {
      padding: 3rem 0;
    }
    .svc-grid {
      grid-template-columns: 1fr;
    }
    .svc {
      border-right: none;
    }
    .info-grid {
      grid-template-columns: 1fr;
      gap: 0.25rem 0;
    }
    .info-grid dt {
      margin-top: 0.8rem;
    }
    .info-grid dt:first-of-type {
      margin-top: 0;
    }
    footer .foot-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
