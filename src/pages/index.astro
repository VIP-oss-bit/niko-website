---
import Layout from '../layouts/Layout.astro';

const title = "Alterations by Nicole · Tailoring & Alterations Studio · Bristol";
const description = "Niko's Alterations is a Bristol-based tailoring and alterations studio run by Nicole. Former Karen Millen model maker; experience with Coast, Oasis, Chanel, Miu Miu and Cameron Balloons. Everyday alterations, suit tailoring, bridal and occasion-wear. By appointment.";
---

<Layout title={title} description={description}>

  <nav class="top">
    <div class="nav-inner">
      <a href="#top" class="brand">Alterations <em>by</em> Nicole</a>
      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#visit">Visit</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <header class="hero" id="top">
    <div class="wrap">
      <div class="hero-eyebrow">Bristol · By appointment</div>
      <h1>Alterations, <em>done right</em>.</h1>
      <p class="hero-sub">A neighbourhood tailoring studio for everyday alterations, formal wear, bridal and careful repairs — at a home studio in Emersons Green, Bristol.</p>
      <div class="ctas">
        <a href="#contact" class="btn btn-primary">Get a quote</a>
        <a href="tel:+447778675571" class="btn btn-ghost">Call or WhatsApp</a>
      </div>
    </div>
  </header>

  <section id="services">
    <div class="wrap">
      <div class="sec-eyebrow">01 · Services</div>
      <h2>Six categories of <em>careful work</em>.</h2>
      <p class="lede">The same care for a £15 zip repair as for a £200 bridal alteration. Honest pricing, quoted in writing at the first appointment.</p>

      <div class="svc-grid">
        <div class="svc">
          <h3>Everyday alterations</h3>
          <ul>
            <li>Hems — trousers, jeans, skirts, dresses</li>
            <li>Take in &amp; let out — waist, seat, sides</li>
            <li>Sleeve shortening</li>
            <li>Resizing for weight change</li>
          </ul>
        </div>
        <div class="svc">
          <h3>Repairs</h3>
          <ul>
            <li>Zip replacement</li>
            <li>Lining repair</li>
            <li>Patching &amp; darning</li>
            <li>Button &amp; fastening replacement</li>
          </ul>
        </div>
        <div class="svc">
          <h3>Suit &amp; formal tailoring</h3>
          <ul>
            <li>Suit jacket adjustment</li>
            <li>Trouser alterations</li>
            <li>Waistcoat resizing</li>
            <li>Shirt tailoring &amp; slim-fitting</li>
          </ul>
        </div>
        <div class="svc">
          <h3>Bridal &amp; occasion-wear</h3>
          <ul>
            <li>Wedding-dress alterations (2–3 fittings)</li>
            <li>Bustle creation</li>
            <li>Bridesmaid &amp; mother-of-the-bride</li>
            <li>Evening &amp; occasion-wear</li>
          </ul>
        </div>
        <div class="svc">
          <h3>Coats &amp; outerwear</h3>
          <ul>
            <li>Coat shortening &amp; resizing</li>
            <li>Sleeve adjustment</li>
            <li>Lining repair</li>
            <li>Button replacement</li>
            <li>Wax reproofing &amp; re-waxing (Barbour-style waxed coats)</li>
          </ul>
        </div>
        <div class="svc">
          <h3>Restyling &amp; specialist</h3>
          <ul>
            <li>Garment remodelling</li>
            <li>Vintage &amp; inherited piece restoration</li>
            <li>Plus-size &amp; inclusive resizing</li>
            <li>Curtain &amp; home alterations (limited)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="sec-eyebrow">02 · About Nicole</div>
      <h2>A working life spent <em>making clothes properly</em>.</h2>

      <p class="lede">Niko's Alterations is a Bristol-based tailoring and alterations studio run by Nicole from her home workspace in Emersons Green.</p>

      <p>Formerly a model maker at Karen Millen, Nicole has also worked with Coast, Oasis, Chanel and Miu Miu — and on the specialist fabric of hot air balloons for Bristol's own Cameron Balloons.</p>

      <p>Her work spans wedding-dress alterations and bridal restyling, suit and formal tailoring, garment restyling, and everyday hems, zips and repairs. All appointments are arranged in advance.</p>

      <div class="callout">
        "The same care for a £15 zip repair as for a £200 bridal alteration."
      </div>
    </div>
  </section>

  <section id="visit">
    <div class="wrap">
      <div class="sec-eyebrow">03 · Visit the studio</div>
      <h2>By appointment, <em>at the home studio</em>.</h2>

      <p>The studio is in Emersons Green, Bristol, and works strictly by appointment so each customer has the time and quiet they need for a proper consultation and fitting. The full address is shared on booking confirmation.</p>

      <dl class="info-grid">
        <dt>Area</dt><dd>Emersons Green, Bristol BS16</dd>
        <dt>Studio access</dt><dd>By appointment — get in touch by email, phone or WhatsApp</dd>
        <dt>Catchment</dt><dd>BS16, BS8, BS6, BS7 and surrounding Bristol</dd>
        <dt>Find us on Google</dt><dd><a href="https://maps.app.goo.gl/FU9yY8E3cFomwGGN9" target="_blank" rel="noopener">Niko's Alterations on Google Maps →</a></dd>
      </dl>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="sec-eyebrow">04 · Contact &amp; booking</div>
      <h2>Get in touch.</h2>

      <p>Fill in the form below, or reach out by email or WhatsApp directly. Consultations are free, take about half an hour, and end with a clear written price.</p>

      <form id="enquiry-form" class="enquiry-form">
        <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="access_key" value="c7b9e070-1372-4e21-8836-fdab457a441c" />
        <input type="hidden" name="subject" value="New enquiry — Alterations by Nicole website" />
        <input type="hidden" name="from_name" value="Alterations by Nicole website" />

        <div class="form-row">
          <div class="field">
            <label for="ef-name">Name</label>
            <input id="ef-name" type="text" name="name" required />
          </div>
          <div class="field">
            <label for="ef-email">Email</label>
            <input id="ef-email" type="email" name="email" required />
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="ef-phone">Phone (optional)</label>
            <input id="ef-phone" type="tel" name="phone" />
          </div>
          <div class="field">
            <label for="ef-service">What do you need?</label>
            <select id="ef-service" name="service">
              <option value="Everyday alterations">Everyday alterations</option>
              <option value="Repairs">Repairs</option>
              <option value="Suit & formal tailoring">Suit &amp; formal tailoring</option>
              <option value="Bridal & occasion-wear">Bridal &amp; occasion-wear</option>
              <option value="Coats & outerwear">Coats &amp; outerwear</option>
              <option value="Restyling & specialist">Restyling &amp; specialist</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="ef-message">Tell us what you need</label>
          <textarea id="ef-message" name="message" rows="4" required placeholder="e.g. Wedding dress needs taking in at the waist, need it done by 12 October"></textarea>
        </div>

        <button type="submit" class="btn btn-primary" id="ef-submit">Send enquiry</button>
        <p class="form-status" id="ef-status" role="status" aria-live="polite"></p>
      </form>

      <dl class="info-grid" style="margin-top: 3rem;">
        <dt>Email</dt><dd><a href="mailto:nicole.alterations@gmail.com">nicole.alterations@gmail.com</a></dd>
        <dt>Phone / WhatsApp</dt><dd><a href="tel:+447778675571">+44 7778 675571</a></dd>
        <dt>Facebook</dt><dd><a href="https://www.facebook.com/share/1NS9GFo5xB/" target="_blank" rel="noopener">Alterations by Nicole on Facebook →</a></dd>
        <dt>Google listing</dt><dd><a href="https://maps.app.goo.gl/FU9yY8E3cFomwGGN9" target="_blank" rel="noopener">Alterations by Nicole on Google →</a></dd>
        <dt>Find us</dt><dd>Emersons Green, Bristol BS16 · address shared on confirmation</dd>
      </dl>

      <p style="margin-top: 2rem;">Studio hours and turnaround times vary by season — we'll always confirm a date in writing before any work begins.</p>
    </div>
  </section>

  <footer>
    <div class="foot-wrap">
      <div class="foot-grid">
        <div>
          <h3>Alterations by Nicole</h3>
          <p>A Bristol tailoring and alterations studio. Honest, careful work — by appointment.</p>
        </div>
        <div>
          <h3>Quick links</h3>
          <p>
            <a href="#services">Services</a> · <a href="#about">About</a> · <a href="#visit">Visit</a> · <a href="#contact">Contact</a><br />
            <a href="mailto:nicole.alterations@gmail.com">Email Nicole</a> · <a href="https://maps.app.goo.gl/FU9yY8E3cFomwGGN9" target="_blank" rel="noopener">Find us on Google</a> · <a href="https://www.facebook.com/share/1NS9GFo5xB/" target="_blank" rel="noopener">Facebook</a>
          </p>
        </div>
      </div>
      <div class="foot-meta">
        <span>© Alterations by Nicole · Bristol</span>
        <span>Made with care</span>
      </div>
    </div>
  </footer>

</Layout>

<style>
  .enquiry-form {
    max-width: 700px;
    margin: 2rem 0 0;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .field {
    margin-bottom: 1.25rem;
  }
  .field label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 0.4rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font-family: 'Inter', 'InterFallback', system-ui, sans-serif;
    font-size: 0.98rem;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--rule);
    padding: 0.65rem 0.8rem;
    transition: border-color 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .enquiry-form button[type='submit'] {
    cursor: pointer;
    font-family: 'Inter', 'InterFallback', system-ui, sans-serif;
  }
  .enquiry-form button[type='submit']:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .form-status {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    max-width: none;
  }
  .form-status.success {
    color: #2f6f3e;
  }
  .form-status.error {
    color: #a3312a;
  }
  @media (max-width: 720px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('ef-status');
  const submitBtn = document.getElementById('ef-submit') as HTMLButtonElement | null;

  if (form && status && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot: if a bot filled this hidden field, silently drop the submission.
      const honeypot = form.querySelector('input[name="botcheck"]') as HTMLInputElement | null;
      if (honeypot && honeypot.checked) {
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'form-status';

      try {
        const formData = new FormData(form);
        const object: Record<string, string> = {};
        formData.forEach((value, key) => {
          object[key] = value.toString();
        });

        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(object),
        });
        const result = await response.json();

        if (result.success) {
          status.textContent = "Thank you — your enquiry has been sent. Nicole will get back to you shortly.";
          status.className = 'form-status success';
          form.reset();
        } else {
          status.textContent = "Something went wrong sending that. Please try again, or email nicole.alterations@gmail.com directly.";
          status.className = 'form-status error';
        }
      } catch (err) {
        status.textContent = "Something went wrong sending that. Please try again, or email nicole.alterations@gmail.com directly.";
        status.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      }
    });
  }
</script>
